# Copy to .env (git-ignored) and adjust. No paid API keys are needed.
# The dev container loads .env automatically if it exists.

# --- Backend ---
APP_ENV=development
DATABASE_URL=sqlite:////workspaces/facelesscreation/data/db/app.db
APP_DATA_DIR=/workspaces/facelesscreation/data

# --- Ollama (internal Docker network only, never published) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# --- Text to speech: Kokoro on CPU by default ---
TTS_DEVICE=cpu
KOKORO_VOICE=af_heart

# --- Speech to text: Faster Whisper, CPU INT8 to start ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Video encoding: auto = NVENC when it works, otherwise libx264 ---
VIDEO_ENCODER=auto

# --- Optional ComfyUI (only when the "comfyui" profile is running) ---
COMFYUI_URL=http://comfyui:8188
